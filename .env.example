PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mathphysics_app
DB_PASSWORD=cambia_esta_password
DB_NAME=mathphysics

# Genera uno propio y distinto para producción: openssl rand -hex 64
JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio

# Duración del token de estudiante
JWT_EXPIRES_IN=7d

# Minutos de bloqueo tras 5 intentos fallidos (RQF3 / RQNF5)
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Minutos de inactividad antes de expirar sesión de administrador (RQNF35)
ADMIN_INACTIVIDAD_MINUTOS=30
